# SEC requires a real product/operator identity with a monitored email address.
SEC_USER_AGENT=MarefaFinancialEngine operator@example.com

# Optional but recommended before exposing the API beyond localhost.
FINENGINE_API_KEY=replace-with-a-long-random-secret

# Optional Telegram read-only adapter.
TELEGRAM_BOT_TOKEN=

# Optional fallback reader. It is never invoked unless --llm is enabled.
ANTHROPIC_API_KEY=
