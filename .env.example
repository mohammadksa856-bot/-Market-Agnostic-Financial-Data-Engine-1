# SEC requires a real product/operator identity with a monitored email address.
SEC_USER_AGENT=MarefaFinancialEngine operator@example.com

# Optional but recommended before exposing the API beyond localhost.
FINENGINE_API_KEY=replace-with-a-long-random-secret

# Optional Telegram read-only adapter.
TELEGRAM_BOT_TOKEN=

# Optional fallback reader. It is never invoked unless --llm is enabled.
ANTHROPIC_API_KEY=

# Production defaults: monitor every 6 hours, inspect up to 50 new links, and
# keep two weeks of daily verified database backups.
FINENGINE_SCHEDULE_SECONDS=21600
FINENGINE_SOURCE_LIMIT=50
# Saudi Exchange currently rejects Chromium's fully headless mode. Docker runs
# headed Chromium inside an isolated virtual display; no desktop window is shown.
FINENGINE_BROWSER_HEADLESS=false
FINENGINE_UNIVERSE_REFRESH_SECONDS=86400
FINENGINE_BACKUP_SECONDS=86400
FINENGINE_BACKUP_KEEP=14
FINENGINE_BUNDLE_KEEP=7

# Persistent runtime data lives outside the Git checkout. Use absolute paths on
# a server so releases can be replaced without touching the database or backups.
FINENGINE_STATE_DIR=./runtime
FINENGINE_BACKUP_DIR=./backups

# Public HTTPS endpoint used by the production Caddy reverse proxy.
API_DOMAIN=api.example.com
CADDY_DATA_DIR=./runtime/caddy/data
CADDY_CONFIG_DIR=./runtime/caddy/config

# Enable optional continuously running adapters after their secrets are set.
# COMPOSE_PROFILES=supabase,telegram

# Publishing to the consumer application (finengine export-supabase).
# The service-role key has full write access - keep it local, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
FINENGINE_SUPABASE_SYNC_SECONDS=300
