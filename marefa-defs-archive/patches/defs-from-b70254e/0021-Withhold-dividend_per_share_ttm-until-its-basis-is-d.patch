From 271f145297f5b027ec9258fafc7de0ec34bd32a5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 18:29:57 +0000
Subject: [PATCH 21/21] Withhold dividend_per_share_ttm until its basis is
 decided

The engine's reviewed SABIC manifests file dividend_per_share_ttm as DPS
declared for the fiscal year, while a sum of quarterly DPS paid inside
the window is a different basis. The two cannot both stand for one key,
so per-share quarters no longer produce it; total_dividend_paid_ttm,
filed as cash paid in the same precedent, is kept.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CfTpoii6QDStyTPdotmEdY
---
 src/finengine/calculations.py      | 6 ++++--
 tests/test_contract_derivations.py | 9 ++++-----
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/src/finengine/calculations.py b/src/finengine/calculations.py
index d489fc8..5c10dd8 100644
--- a/src/finengine/calculations.py
+++ b/src/finengine/calculations.py
@@ -9,8 +9,10 @@ class Calculator:
     """Deterministic, source-traceable calculations; AI never calculates production facts."""
 
     TTM_FLOWS = {"revenue", "net_income", "operating_cash_flow", "capex", "free_cash_flow"}
-    # Quarterly dividends whose trailing-twelve-month sum has its own catalog key.
-    TTM_NAMED = {"dividends_per_share": "dividend_per_share_ttm", "dividends_paid": "total_dividend_paid_ttm"}
+    # Quarterly dividends whose trailing-twelve-month sum has its own catalog key. Cash paid only:
+    # dividend_per_share_ttm is filed for SABIC as DPS declared for the year, so a sum of DPS paid in the
+    # window is a different basis and stays withheld until that basis is decided.
+    TTM_NAMED = {"dividends_paid": "total_dividend_paid_ttm"}
     HISTORY_METRICS = {
         "revenue", "gross_profit", "operating_income", "income_before_income_taxes_and_zakat",
         "income_taxes_and_zakat",
diff --git a/tests/test_contract_derivations.py b/tests/test_contract_derivations.py
index f4984a3..131bced 100644
--- a/tests/test_contract_derivations.py
+++ b/tests/test_contract_derivations.py
@@ -251,7 +251,7 @@ class TrailingTwelveMonthTests(unittest.TestCase):
         self.assertEqual(result.period_start, "2025-04-01")
         self.assertEqual(result.period_kind, PeriodKind.TTM)
 
-    def dividend_ttm(self, quarterly, annual=None, metric="dividends_per_share", unit="SAR/share"):
+    def dividend_ttm(self, quarterly, annual=None, metric="dividends_paid", unit="SAR"):
         facts = [quarter(metric, value, end, start, 2025, q, unit=unit)
                  for (start, end, _, q), value in zip(self.QUARTERS[:4], quarterly)]
         if annual is not None:
@@ -262,10 +262,9 @@ class TrailingTwelveMonthTests(unittest.TestCase):
         return {key: value for key, value in out.items() if value.period_kind == PeriodKind.TTM}
 
     def test_quarterly_dividends_produce_the_named_ttm_keys(self):
-        per_share = self.dividend_ttm(["0.3312"] * 4, annual="1.3248")
-        self.assertEqual(set(per_share), {("dividend_per_share_ttm", "2025-12-31")})
-        self.assertEqual(per_share["dividend_per_share_ttm", "2025-12-31"].value, Decimal("1.3248"))
-        self.assertEqual(per_share["dividend_per_share_ttm", "2025-12-31"].unit, "SAR/share")
+        # DPS paid in the window is not the filed declared-for-the-year basis: no per-share TTM is derived.
+        self.assertEqual(self.dividend_ttm(["0.3312"] * 4, annual="1.3248", metric="dividends_per_share",
+                                           unit="SAR/share"), {})
         paid = self.dividend_ttm(["80104", "80112", "80113", "80118"], annual="320447",
                                  metric="dividends_paid", unit="SAR")
         self.assertEqual(paid["total_dividend_paid_ttm", "2025-12-31"].value, Decimal("320447"))
