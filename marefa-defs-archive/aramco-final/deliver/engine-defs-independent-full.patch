+   "type": "string"
+  },
+  "engine_sha": {
+   "type": "string"
+  },
+  "company_id": {
+   "type": "string",
+   "minLength": 1
+  },
+  "engine_total_score": {
+   "anyOf": [
+    {
+     "type": "number"
+    },
+    {
+     "type": "string",
+     "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$"
+    }
+   ]
