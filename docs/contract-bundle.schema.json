{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "finengine/contract-bundle-v1",
 "title": "Factory-contract evidence bundle, version 1",
 "description": "The contract a pipeline scored against and its per-key evidence. Checked by `finengine contract-validate`, which also enforces the cross-field rules this schema cannot express (unique keys, every contract key recorded, records only for contract keys).",
 "type": "object",
 "required": [
  "bundle_version",
  "company_id",
  "contract",
  "records"
 ],
 "properties": {
  "bundle_version": {
   "const": 1
  },
  "label": {
   "type": "string"
  },
  "engine_sha": {
   "type": "string"
  },
  "company_id": {
   "type": "string",
   "minLength": 1
  },
  "engine_total_score": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "string",
     "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$"
    }
   ]
  },
  "record_default": {
   "enum": [
    "missing"
   ],
   "description": "Contract keys without a record are missing."
  },
  "contract": {
   "type": "object",
   "required": [
    "categories"
   ],
   "properties": {
    "version": {},
    "categories": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "key",
       "weight"
      ],
      "properties": {
       "key": {
        "type": "string",
        "minLength": 1
       },
       "weight": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$"
         }
        ]
       },
       "not_applicable": {
        "type": "boolean"
       },
       "score_only": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$"
         }
        ],
        "description": "Category scored without a field list, between 0 and 1."
       },
       "fields": {
        "type": "array",
        "items": {
         "anyOf": [
          {
           "type": "string",
           "minLength": 1
          },
          {
           "type": "object",
           "required": [
            "key"
           ],
           "properties": {
            "key": {
             "type": "string",
             "minLength": 1
            },
            "definition": {
             "type": [
              "string",
              "null"
             ]
            },
            "unit": {
             "type": [
              "string",
              "null"
             ]
            },
            "period_behavior": {
             "type": [
              "string",
              "null"
             ]
            },
            "value_type": {
             "type": [
              "string",
              "null"
             ]
            },
            "storage_domain": {
             "type": [
              "string",
              "null"
             ]
            }
           }
          }
         ]
        }
       }
      }
     }
    }
   }
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "key",
     "status"
    ],
    "properties": {
     "key": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "enum": [
       "closed",
       "missing",
       "excluded"
      ]
     },
     "storage_domain": {
      "type": "string"
     },
     "observations": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "period_kind",
        "period_end",
        "value"
       ],
       "properties": {
        "period_kind": {
         "enum": [
          "instant",
          "quarter",
          "ytd",
          "fy",
          "ttm",
          "as_of",
          "daily"
         ]
        },
        "period_start": {
         "anyOf": [
          {
           "type": "string",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          {
           "type": "null"
          },
          {
           "const": ""
          }
         ]
        },
        "period_end": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "dimensions": {
         "type": "string"
        },
        "value": {},
        "unit": {
         "type": [
          "string",
          "null"
         ]
        },
        "currency": {
         "type": [
          "string",
          "null"
         ]
        },
        "source_url": {
         "type": [
          "string",
          "null"
         ]
        },
        "calculation": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  },
  "engine_corrections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "keys"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "keys": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
